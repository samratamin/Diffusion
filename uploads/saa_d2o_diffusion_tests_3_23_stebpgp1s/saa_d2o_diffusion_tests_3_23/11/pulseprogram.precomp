# 30 "/root/.topspin-BladeEpu/local_acqu/SAA_D2O_Diffusion_Tests_3_23/11/lists/pp/stebpgp1s"
  50u setrtp0|0 ctrlgrad 0
  p1 ph1
  p30:gp6*diff
  d16
  p2 ph2
  p30:gp6*-1*diff
  d16
  p1 ph3
  p19:gp7
  d16
  DELTA1
  p1 ph4
  p30:gp6*diff
  d16
  p2 ph2
  p30:gp6*-1*diff
  d16
  4u setrtp0^0 ctrlgrad 4047
  go=2 ph31 
# 1 "mc_line 49 file /root/.topspin-BladeEpu/local_acqu/SAA_D2O_Diffusion_Tests_3_23/11/lists/pp/stebpgp1s exp. mc cmd. in line"
  MCWRK  wr #0 if #0 zd 

  "t1loop+=1 * (1 - kronecker_delta(1 , td1) )"
      MCWRK
      "phval0 = t1loop * 1"
      MCWRK setgrad diff
  lo to LBLST1 times ST1CNT
  MCWRK 
  "t1loop=0"
  MCWRK rf #0
  lo to LBLAV times tdav
